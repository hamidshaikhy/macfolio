{
  "expo": {
    "name": "to do list",
    "slug": "to-do-list-planner",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.hamidshaikhy.rooz",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#b64d32"
      },
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-font"
    ],
    "updates": {
      "enabled": false
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
