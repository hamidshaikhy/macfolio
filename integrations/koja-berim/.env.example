# Optional Neshan place search/details/routing. Leaflet basemap requires no key.
# Enable only when the /api/neshan gateway is deployed (Vercel or npm run dev).
VITE_NESHAN_API=false
VITE_NESHAN_GATEWAY=/api/neshan
# Server-side API key. Never prefix this one with VITE_. Activate nearby/routing in Neshan panel.
NESHAN_API_KEY=
# Optional build base when embedding under Macfolio. Default ./ works in its own folder.
# APP_BASE=/apps/koja-berim/
